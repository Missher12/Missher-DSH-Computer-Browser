{
  "name": "@missher/dsh-computer-browser",
  "version": "0.1.0-rc.5",
  "description": "Visible Browser Use and session-owned Computer Use for compatible Missher DeepSeek Harness Desktop builds.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "VALIDATION.md",
    "COMPATIBILITY.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SOURCE_ORIGINS.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts --maxWorkers=1",
    "pack:candidate": "node scripts/pack.mjs",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-browser-use": "*",
    "@deepseek-ai/dsh-computer-use": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@playwright/mcp": "0.0.80",
    "@trycua/cua-driver": "0.28.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-browser-use": "0.2.0-rc.2",
    "@deepseek-ai/dsh-computer-use": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "22.19.15",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Missher12/Missher-DSH-Computer-Browser.git"
  },
  "homepage": "https://github.com/Missher12/Missher-DSH-Computer-Browser#readme",
  "bugs": {
    "url": "https://github.com/Missher12/Missher-DSH-Computer-Browser/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "browser-use",
    "computer-use",
    "playwright",
    "electron"
  ],
  "author": "Missher",
  "publishConfig": {
    "access": "public"
  }
}
